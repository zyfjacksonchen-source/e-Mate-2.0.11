{
  "name": "@e-mate/dsh-workspace",
  "version": "2.0.8",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:target": "node scripts/check-target.mjs",
    "chat:fixture": "node scripts/create-chat-state-fixture.mjs",
    "performance:fixture": "node scripts/create-performance-fixture.mjs",
    "performance:parity": "pnpm run check:target && node scripts/performance-parity.mjs",
    "test:performance:parity": "node --test scripts/performance-parity.test.mjs",
    "test": "node --test scripts/create-chat-state-fixture.test.mjs && pnpm run test:performance:parity && pnpm run build && pnpm -r --filter './packages/dsh-plugin-*' --workspace-concurrency=4 --if-present test && pnpm --filter @e-mate/dsh test",
    "test:release": "node --test scripts/release.test.mjs",
    "build": "pnpm -r --filter './packages/dsh-plugin-*' --workspace-concurrency=4 --if-present build && pnpm --filter @e-mate/dsh build",
    "enterprise:check": "pnpm --dir enterprise check",
    "enterprise:test": "pnpm --dir enterprise test",
    "enterprise:build": "pnpm --dir enterprise build",
    "pack:check": "pnpm --filter @e-mate/dsh pack --pack-destination dist/npm",
    "release:evidence": "node scripts/release.mjs evidence --from dist/npm --out dist/release",
    "release:publish": "node scripts/release.mjs publish --from dist/npm",
    "release:r2": "node scripts/publish-r2.mjs --npm dist/npm --evidence dist/release --receipt dist/r2/r2-download-admission.json"
  }
}
