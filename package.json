{
  "name": "@e-mate/dsh-workspace",
  "version": "2.0.15",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "fflate": "0.8.3"
  },
  "workspaces": [
    "packages/dsh"
  ],
  "scripts": {
    "build:harness": "node scripts/harness-provenance.mjs build",
    "flow": "node scripts/local-flow.mjs",
    "check:target": "node scripts/check-target.mjs",
    "check:release-boundary": "node scripts/change-impact.mjs --check-contract",
    "component:inventory": "node scripts/component-release.mjs inventory",
    "chat:fixture": "node scripts/create-chat-state-fixture.mjs",
    "performance:fixture": "node scripts/create-performance-fixture.mjs",
    "performance:acceptance": "node scripts/performance-acceptance.mjs",
    "performance:parity": "pnpm run check:target && node scripts/performance-parity.mjs",
    "test:performance:parity": "node --test scripts/performance-parity.test.mjs scripts/performance-acceptance.test.mjs scripts/performance-acceptance-probe.test.mjs",
    "test": "pnpm run test:harness-provenance && pnpm run test:impact && node --test scripts/create-chat-state-fixture.test.mjs && pnpm run test:performance:parity && node scripts/component-run.mjs check && pnpm --filter @e-mate/dsh build && pnpm --filter @e-mate/dsh test",
    "test:harness-provenance": "node --test scripts/harness-provenance.test.mjs scripts/harness-runtime-adapters.test.mjs",
    "test:impact": "node --test scripts/change-impact.test.mjs scripts/component-release.test.mjs scripts/profile-release.test.mjs scripts/publish-profile-r2.test.mjs",
    "test:fast": "pnpm run test:harness-provenance && pnpm run test:impact && node --test scripts/create-chat-state-fixture.test.mjs",
    "test:release": "node --test scripts/desktop-admission.test.mjs scripts/release.test.mjs",
    "check:affected": "node scripts/change-impact.mjs",
    "smoke:app-dir": "pnpm --dir desktop package:dir",
    "verify:rc": "pnpm build:harness && pnpm run test:fast && node scripts/component-run.mjs check && pnpm --filter @e-mate/dsh test && pnpm run test:release",
    "audit:full": "pnpm test && pnpm test:release",
    "build": "node scripts/component-run.mjs build && pnpm --filter @e-mate/dsh build",
    "enterprise:check": "pnpm --dir enterprise check",
    "enterprise:test": "pnpm --dir enterprise test",
    "enterprise:build": "pnpm --dir enterprise build",
    "pack:check": "pnpm --filter @e-mate/dsh pack --pack-destination dist/npm",
    "release:evidence": "node scripts/release.mjs evidence --from dist/npm --out dist/release",
    "release:publish": "node scripts/release.mjs publish --from dist/npm"
  }
}
