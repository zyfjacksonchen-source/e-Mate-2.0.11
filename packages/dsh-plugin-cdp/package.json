{
  "name": "@e-mate/dsh-plugin-cdp",
  "version": "2.0.12",
  "description": "DSH-native Chrome DevTools Protocol adapter for e-Mate",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cdp": {
      "types": "./lib/cdp.d.mts",
      "default": "./lib/cdp.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "pnpm-lock.yaml",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyfjacksonchen-source/e-Mate-2.0.11.git",
    "directory": "packages/dsh-plugin-cdp"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "eMate": {
    "component": {
      "schema_version": 1,
      "id": "@e-mate/dsh-plugin-cdp",
      "kind": "profile",
      "base_imports": ["@deepseek-ai/dsh-settings", "@deepseek-ai/schemastery"],
      "authority_contract": {
        "effects": ["browser-control", "browser-read", "network-loopback", "subprocess"],
        "guards": ["explicit-user-action", "fixed-endpoint", "native-approval", "native-user-question", "plugin-settings-grant", "session-scope"]
      },
      "base_contracts": ["e-mate-desktop-profile-v6-dsh-2bc16230975f"]
    },
    "harnessVersion": "0.1.0-rc.7",
    "harnessCommit": "2bc16230975f6cf02aa1b283b1f86de44007b059"
  }
}
