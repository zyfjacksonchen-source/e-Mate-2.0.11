{
  "name": "@e-mate/dsh-plugin-cdp",
  "version": "2.0.11",
  "description": "DSH-native Chrome DevTools Protocol adapter for e-Mate",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cdp": {
      "types": "./lib/cdp.d.mts",
      "default": "./lib/cdp.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyfjacksonchen-source/e-Mate.git",
    "directory": "packages/dsh-plugin-cdp"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "eMate": {
    "component": {
      "schema_version": 1,
      "id": "@e-mate/dsh-plugin-cdp",
      "kind": "profile",
      "base_imports": [],
      "base_contracts": ["e-mate-desktop-profile-v1-dsh-df78045a127e"]
    },
    "harnessVersion": "0.1.0-rc.7",
    "harnessCommit": "df78045a127e32cb5b942defba52c539590d1596"
  }
