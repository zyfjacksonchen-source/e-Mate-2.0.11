{
  "name": "@e-mate/dsh-plugin-browser-panel",
  "version": "2.0.7",
  "description": "Fail-closed browser panel adapter for the pinned e-Mate 2.0.7 local runtime.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && ../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm build && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.0-rc.5",
    "harnessCommit": "47f943859bef60e4160492346772ded9b24f765a",
    "upstream": {
      "catalogRepository": "https://github.com/dsh-external/dsh-browser-panel",
      "sourceStatus": "blocked",
      "npmStatus": "not-published",
      "verifiedAt": "2026-08-15"
    },
    "providerStatus": "platform-dependent-unverified",
    "windowsCandidate": {
      "package": "@playwright/mcp",
      "version": "0.0.78",
      "browser": "system-edge",
      "status": "setup-required",
      "blocker": "PLAYWRIGHT_MCP_EDGE_UNVERIFIED"
    },
    "excludedFeatures": [
      "browser-control",
      "standalone-http-api",
      "standalone-websocket",
      "independent-store",
      "model-configuration"
    ]
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "private": true
}
