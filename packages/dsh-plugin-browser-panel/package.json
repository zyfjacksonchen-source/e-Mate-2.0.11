{
  "name": "@e-mate/dsh-plugin-browser-panel",
  "version": "2.0.9",
  "description": "Status projection for the native rc.7 dsh-browser bridge in e-Mate.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && ../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm build && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "eMate": {
    "harnessVersion": "0.1.0-rc.7",
    "upstream": {
      "repository": "https://github.com/Lum1104/dsh-browser",
      "commit": "01f0b216b1bde88b5f9c6575ce9fb922db6fd8fb",
      "verifiedAt": "2026-08-16"
    },
    "providerStatus": "dsh-browser-extension-connection",
    "windowsBlocker": "DSH_BROWSER_WINDOWS_ACCEPTANCE_PENDING",
    "excludedFeatures": [
      "browser-control",
      "standalone-http-api",
      "standalone-websocket",
      "independent-store",
      "model-configuration"
    ]
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "private": true
}
