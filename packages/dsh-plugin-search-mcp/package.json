{
  "name": "@e-mate/dsh-plugin-search-mcp",
  "version": "2.0.8",
  "description": "e-Mate adapter for the pinned dsh-search-mcp provider",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown src/index.ts --format esm --dts --clean --out-dir lib --deps.never-bundle '@deepseek-ai/**' --deps.always-bundle '@modelcontextprotocol/**'",
    "test": "pnpm run build && node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "eMate": {
    "harnessVersion": "0.1.0-rc.5",
    "harnessCommit": "47f943859bef60e4160492346772ded9b24f765a",
    "mcpSdkVersion": "1.29.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
