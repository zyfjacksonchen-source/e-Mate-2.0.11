{
  "name": "@e-mate/dsh-plugin-search-mcp",
  "version": "2.0.12",
  "description": "e-Mate adapter for the pinned dsh-search-mcp provider",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "pnpm-lock.yaml",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "eMate": {
    "component": {
      "schema_version": 1,
      "id": "@e-mate/dsh-plugin-search-mcp",
      "kind": "profile",
      "base_imports": [
        "@deepseek-ai/dsh-credentials",
        "@deepseek-ai/dsh-settings",
        "@deepseek-ai/dsh-web",
        "@deepseek-ai/schemastery"
      ],
      "authority_contract": {
        "effects": ["credentials-read", "credentials-write", "network-remote"],
        "guards": ["explicit-user-action", "fixed-catalog"]
      },
      "base_contracts": ["e-mate-desktop-profile-v6-dsh-2bc16230975f"]
    },
    "harnessVersion": "0.1.0-rc.7",
    "harnessCommit": "2bc16230975f6cf02aa1b283b1f86de44007b059",
    "mcpSdkVersion": "1.29.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
