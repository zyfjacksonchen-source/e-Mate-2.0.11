{
  "name": "@e-mate/dsh-plugin-mcp-manage",
  "version": "2.0.13",
  "description": "DSH-native MCP connection management for e-Mate",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": { "types": "./lib/index.d.mts", "default": "./lib/index.mjs" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "pnpm-lock.yaml", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test test/contract.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "eMate": {
    "component": {
      "schema_version": 1,
      "id": "@e-mate/dsh-plugin-mcp-manage",
      "kind": "profile",
      "base_imports": [
        "@deepseek-ai/dsh-credentials",
        "@deepseek-ai/dsh-settings",
        "@deepseek-ai/dsh-tools",
        "@deepseek-ai/schemastery"
      ],
      "authority_contract": {
        "effects": ["credentials-read", "credentials-write", "desktop-restart", "host-plugin-install", "network-remote", "persistent-state", "subprocess"],
        "guards": ["atomic-receipt", "explicit-user-action", "fixed-catalog", "native-user-question"]
      },
      "base_contracts": ["e-mate-desktop-profile-v7-dsh-b2b1650b01f0"]
    },
    "harnessVersion": "0.1.0-rc.7",
    "harnessCommit": "b2b1650b01f0ee88d81837a9b5c050f9f763f606",
    "runtime": "@deepseek-ai/dsh-mcp-client",
    "mcpSdkVersion": "1.29.0"
  },
  "publishConfig": { "access": "public" }
}
