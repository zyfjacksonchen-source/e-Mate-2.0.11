{
  "name": "@e-mate/dsh-plugin-file-import",
  "version": "2.0.12",
  "description": "Session-bound local file import for the e-Mate DSH composer.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./contract": "./lib/contract.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "pnpm-lock.yaml",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && ../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm build && pnpm test"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "eMate": {
    "component": {
      "schema_version": 1,
      "id": "@e-mate/dsh-plugin-file-import",
      "kind": "profile",
      "base_imports": ["@deepseek-ai/dsh-client-ui-primitives", "react"],
      "authority_contract": {
        "effects": ["filesystem-read", "filesystem-write", "network-loopback"],
        "guards": ["atomic-receipt", "explicit-user-action", "session-scope", "workspace-scope"]
      },
      "base_contracts": ["e-mate-desktop-profile-v6-dsh-2bc16230975f"]
    },
    "harnessVersion": "0.1.0-rc.7",
    "harnessCommit": "e13ce9d953037a2f40d866d17f5a7e00cbc15d66",
    "excludedFeatures": [
      "independent-store",
      "independent-router",
      "independent-chat-transport",
      "arbitrary-host-path"
    ]
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "os": ["darwin", "win32"],
  "license": "MIT",
  "private": true
}
