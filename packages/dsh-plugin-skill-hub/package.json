{
  "name": "@e-mate/dsh-plugin-skill-hub",
  "version": "2.0.11",
  "description": "DSH-native Skill Hub catalog, lifecycle, Agent tools, and UI for e-Mate",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skill-hub": "./lib/skill-hub.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf lib && ../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "pnpm run build && node --test test/*.test.mjs && ../../upstream/deepseek-harness/node_modules/.bin/vitest run test/*.spec.tsx"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.0-rc.7",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-skill": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@testing-library/react": "16.3.2",
    "fflate": "0.8.3",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yaml": "2.9.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "eMate": {
    "component": {
      "schema_version": 1,
      "id": "@e-mate/dsh-plugin-skill-hub",
      "kind": "profile",
      "base_imports": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-skill-filesystem",
        "@deepseek-ai/dsh-tools",
        "react"
      ],
      "base_contracts": ["e-mate-desktop-profile-v1-dsh-df78045a127e"]
    },
    "harnessVersion": "0.1.0-rc.7",
    "harnessCommit": "df78045a127e32cb5b942defba52c539590d1596"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "os": ["darwin", "win32"],
  "license": "MIT",
  "private": true
}
