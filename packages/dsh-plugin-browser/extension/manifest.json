{
  "manifest_version": 3,
  "name": "e-Mate 浏览器",
  "description": "让 e-Mate 通过本机 DeepSeek Harness 工具链操作用户明确绑定的浏览器标签页。",
  "version": "2.0.10",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "webNavigation", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "e-Mate 浏览器",
    "default_icon": { "16": "assets/icon.png", "32": "assets/icon.png" }
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_origin_as_fallback": true
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
  },
  "icons": { "16": "assets/icon.png", "32": "assets/icon.png", "48": "assets/icon.png", "128": "assets/icon.png" }
}
