{
  "name": "@e-mate/dsh-plugin-computer-use",
  "version": "2.0.13",
  "description": "e-Mate adapter for Anionex dsh-computer-use on the pinned rc.7 runtime",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types", "native", "assets", "scripts/build-native.mjs", "docs", "pnpm-lock.yaml", "cordis.patch.yml", "README.md", "SOURCE.md", "LICENSE"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/contract.test.mjs"
  },
  "dependencies": { "zod": "4.4.3" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-api-remotes"],
      "platform": "web"
    },
    "upstream": {
      "repository": "https://github.com/Anionex/dsh-computer-use",
      "commit": "76bfe8607f61945c1cbb84e73976e601100c13a2"
    }
  },
  "eMate": {
    "component": {
      "schema_version": 1,
      "id": "@e-mate/dsh-plugin-computer-use",
      "kind": "platform-profile",
      "base_imports": [
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-llm",
        "@deepseek-ai/dsh-settings",
        "@deepseek-ai/dsh-storage-domain",
        "@deepseek-ai/dsh-tools",
        "@deepseek-ai/schemastery",
        "react"
      ],
      "authority_contract": {
        "effects": ["filesystem-write", "os-accessibility", "os-input-control", "os-screen-recording", "subprocess"],
        "guards": ["explicit-user-action", "native-approval", "os-tcc", "plugin-settings-grant", "session-scope", "workspace-scope"]
      },
      "base_contracts": ["e-mate-desktop-profile-v7-dsh-e13ce9d95303"]
    },
    "harnessVersion": "0.1.0-rc.7",
    "harnessCommit": "e13ce9d953037a2f40d866d17f5a7e00cbc15d66"
  }
}
