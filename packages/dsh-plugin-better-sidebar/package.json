{
  "name": "@e-mate/dsh-plugin-better-sidebar",
  "version": "2.0.15",
  "description": "Project-scoped file sidebar for the pinned e-Mate 2.0.15 local runtime.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "pnpm-lock.yaml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "rm -rf lib && ../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test test/*.test.mjs && pnpm test:client",
    "test:client": "../../upstream/deepseek-harness/node_modules/.bin/vitest run --config vitest.config.ts",
    "check": "pnpm build && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "eMate": {
    "component": {
      "schema_version": 1,
      "id": "@e-mate/dsh-plugin-better-sidebar",
      "kind": "profile",
      "base_imports": ["react"],
      "authority_contract": {
        "effects": ["filesystem-read"],
        "guards": ["session-scope", "workspace-scope"]
      },
      "base_contracts": ["e-mate-desktop-profile-v12-dsh-f97e3814fe67"]
    },
    "harnessVersion": "0.1.0-rc.7",
    "harnessCommit": "f97e3814fe677b35e2c0a4cdaec70c1fc1c8e1f4",
    "excludedUpstreamFeatures": ["terminal", "node-pty", "standalone-websocket", "standalone-http-api"]
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "private": true
}
