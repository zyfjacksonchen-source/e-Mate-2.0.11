{
  "name": "@e-mate/dsh-plugin-office-skills",
  "version": "2.0.11",
  "description": "Clean-room DOCX, PDF, XLSX, and PPTX skills for the e-Mate profile",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "pnpm-lock.yaml",
    "lib",
    "src",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyfjacksonchen-source/e-Mate-2.0.11.git",
    "directory": "packages/dsh-plugin-office-skills"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/copy-font-assets.mjs",
    "build": "pnpm run prepare:assets && ../../upstream/deepseek-harness/node_modules/.bin/tsdown",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "officeSkills": {
      "adapterState": "ready",
      "runtimeInstalled": true,
      "toolsRegistered": 2
    }
  },
  "eMate": {
    "component": {
      "schema_version": 1,
      "id": "@e-mate/dsh-plugin-office-skills",
      "kind": "profile",
      "base_imports": [],
      "authority_contract": {
        "effects": ["filesystem-read", "filesystem-write"],
        "guards": ["sandbox-policy", "session-scope", "workspace-scope"]
      },
      "base_contracts": ["e-mate-desktop-profile-v2-dsh-df78045a127e"]
    },
    "harnessVersion": "0.1.0-rc.7",
    "harnessCommit": "df78045a127e32cb5b942defba52c539590d1596"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@xmldom/xmldom": "0.9.11",
    "docx": "9.7.1",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdf2json": "4.0.3",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0"
  }
}
