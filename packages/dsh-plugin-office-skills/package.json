    "./cordis.patch.yml": "./cordis.patch.yml",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyfjacksonchen-source/e-Mate.git",
    "directory": "packages/dsh-plugin-office-skills"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsc -p tsconfig.json",
    "test": "pnpm run build && node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
