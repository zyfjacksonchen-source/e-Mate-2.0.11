{
  "name": "@e-mate/dsh-plugin-office-skills",
  "version": "2.0.7",
  "description": "Clean-room DOCX, PDF, XLSX, and PPTX skills for the e-Mate profile",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
