      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-office-skills",
      "root": "packages/dsh-plugin-office-skills",
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-schedules",
      "root": "packages/dsh-plugin-schedules",
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-tool-search",
      "root": "packages/dsh-plugin-tool-search",
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-vision-toolkit",
      "root": "packages/dsh-plugin-vision-toolkit",
      "source_roots": ["upstream/plugins/dsh-vision-toolkit"],
      "kind": "platform-profile",
      "desktop": "platform-profile",
      "cli": false,
      "targets": [
        {
          "platform": "darwin",
          "arch": "arm64",
          "runtime_abi": "cpython-3.12",
          "minimum_os": "13.0",
          "signing": { "scheme": "adhoc", "identity": "adhoc" },
          "native_paths": ["runtime/wheels/darwin-arm64"]
        },
        {
          "platform": "darwin",
          "arch": "x64",
          "runtime_abi": "cpython-3.12",
          "minimum_os": "13.0",
          "signing": { "scheme": "adhoc", "identity": "adhoc" },
          "native_paths": ["runtime/wheels/darwin-x64"]
        },
        {
          "platform": "win32",
          "arch": "x64",
          "runtime_abi": "cpython-3.12",
          "minimum_os": "10.0",
          "signing": { "scheme": "unsigned", "identity": "none" },
          "native_paths": ["runtime/wheels/win32-x64"]
        }
      ]
    }
  ]
}
