{
  "schema_version": 1,
  "components": [
    {
      "id": "@e-mate/dsh-client-shell",
      "root": "packages/dsh/profile/plugins/emate-shell",
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": false
    },
    {
      "id": "@e-mate/dsh-plugin-skill-hub",
      "root": "packages/dsh-plugin-skill-hub",
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-better-sidebar",
      "root": "packages/dsh-plugin-better-sidebar",
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-cdp",
      "root": "packages/dsh-plugin-cdp",
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-computer-use",
      "root": "packages/dsh-plugin-computer-use",
      "source_roots": ["upstream/plugins/dsh-computer-use"],
      "kind": "platform-profile",
      "desktop": "platform-profile",
      "cli": true,
      "targets": [
        {
          "platform": "darwin",
          "arch": "arm64",
          "runtime_abi": "macos-computer-use-helper-v1",
          "minimum_os": "14.0",
          "signing": { "scheme": "adhoc", "identity": "adhoc" },
          "native_paths": ["native/macos"]
        },
        {
          "platform": "darwin",
          "arch": "x64",
          "runtime_abi": "macos-computer-use-helper-v1",
          "minimum_os": "14.0",
          "signing": { "scheme": "adhoc", "identity": "adhoc" },
          "native_paths": ["native/macos"]
        },
        {
          "platform": "win32",
          "arch": "x64",
          "runtime_abi": "none",
          "minimum_os": "10.0",
          "signing": { "scheme": "unsigned", "identity": "none" },
          "native_paths": []
        }
      ]
    },
    {
      "id": "@e-mate/dsh-plugin-file-import",
      "root": "packages/dsh-plugin-file-import",
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-find-skill",
      "root": "packages/dsh-plugin-find-skill",
      "source_roots": ["upstream/plugins/dsh-find-skill"],
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-genui",
      "root": "packages/dsh-plugin-genui",
      "source_roots": ["upstream/plugins/dsh-genui"],
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-glass-composer",
      "root": "packages/dsh-plugin-glass-composer",
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-mcp-manage",
      "root": "packages/dsh-plugin-mcp-manage",
      "kind": "profile",
      "desktop": "hot-profile",
      "cli": true
    },
    {
      "id": "@e-mate/dsh-plugin-memory-evolve",
      "root": "packages/dsh-plugin-memory-evolve",
      "kind": "profile",
