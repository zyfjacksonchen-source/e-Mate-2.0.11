{
  "name": "@e-mate/dsh-plugin-memory-evolve",
  "version": "2.0.14",
  "description": "Project-isolated memory adapter for the pinned e-Mate 2.0.14 local runtime",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
