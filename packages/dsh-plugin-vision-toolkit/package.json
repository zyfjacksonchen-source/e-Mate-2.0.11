{
  "name": "@e-mate/dsh-plugin-vision-toolkit",
  "version": "2.0.11",
  "description": "Fail-closed e-Mate rc.5 adapter boundary for dsh-vision-toolkit",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "visionToolkit": {
      "adapterState": "blocked",
      "upstreamRepository": "https://github.com/Anionex/dsh-vision-toolkit",
      "upstreamCommit": "29850a83871d4b7a7cc13e251420c5a440e2f69e"
    }
  },
  "scripts": {
    "build": "../../upstream/deepseek-harness/node_modules/.bin/tsdown src/index.ts --format esm --dts --clean --out-dir lib --deps.never-bundle '@deepseek-ai/**'",
    "test": "pnpm run build && node --test"
  },
  "eMate": {
    "component": {
      "schema_version": 1,
      "id": "@e-mate/dsh-plugin-vision-toolkit",
      "kind": "profile",
      "base_imports": [
        "@deepseek-ai/dsh-settings",
        "@deepseek-ai/dsh-tools",
        "@deepseek-ai/schemastery"
      ],
      "base_contracts": ["e-mate-desktop-profile-v1-dsh-df78045a127e"]
    },
    "harnessVersion": "0.1.0-rc.7",
    "harnessCommit": "df78045a127e32cb5b942defba52c539590d1596"
  },
  "publishConfig": {
    "access": "public"
  }
}
